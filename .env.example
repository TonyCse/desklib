# Copier vers .env (ignoré par git) et adapter si besoin.
DATABASE_URL="postgresql://ilot:ilot@localhost:5432/ilot?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3000
WEB_ORIGIN="http://localhost:4200"
NODE_ENV="development"

# Neon (production) : coller l'URL complète fournie par Neon dans .env, jamais ici.
# Format attendu : postgresql://<user>:<password>@<host>-pooler.<region>.neon.tech/<db>?sslmode=require
# Pour les migrations, utiliser l'URL directe (sans "-pooler" dans le host).
